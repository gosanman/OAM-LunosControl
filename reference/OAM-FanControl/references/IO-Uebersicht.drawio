        <mxCell id="s_e_tacho" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#B85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="s_r1" source="s_in_hw" target="s_s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

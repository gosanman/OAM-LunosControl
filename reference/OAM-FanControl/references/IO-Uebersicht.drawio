          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_c34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="s_r1" source="s_s3" target="s_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_c45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="s_r1" source="s_s4" target="s_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_c56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="s_r1" source="s_s5" target="s_s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_c67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="s_r1" source="s_s6" target="s_s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_e_out1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82B366;exitX=1;exitY=0.167;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s_r1" source="s_box_container" target="s_out_ko">
          <mxGeometry relative="1" as="geometry" />
